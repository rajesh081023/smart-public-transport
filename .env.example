# Flask Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smart_transport_clean_mobility_secret_key_2026

# Database Configuration
# DB_TYPE options: 'mysql', 'sqlite', or 'auto'
# 'auto' tries MySQL first; if unavailable, falls back gracefully to local SQLite.
DB_TYPE=auto

# MySQL Settings (Used if DB_TYPE is mysql or auto)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=smart_mobility_db

# SQLite Settings (Used if DB_TYPE is sqlite or fallback)
SQLITE_DB=smart_mobility.db
