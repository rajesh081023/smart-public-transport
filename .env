# Flask Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smart_transport_clean_mobility_secret_key_2026

# Database Configuration
# Set DB_TYPE=auto to try MySQL first, falling back to SQLite if MySQL is offline.
# Or set DB_TYPE=mysql to strictly use MySQL.
DB_TYPE=auto

# MySQL Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=smart_mobility_db

# SQLite Settings (Used when MySQL is offline or DB_TYPE=sqlite)
SQLITE_DB=smart_mobility.db
